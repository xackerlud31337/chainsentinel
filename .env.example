# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Ethereum JSON-RPC endpoint (read-only). Free tiers: Alchemy, Infura, Ankr, or a public node.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_EXPECTED_CHAIN_ID=1
RPC_TIMEOUT_SECONDS=10

# PostgreSQL (matches docker-compose.yml). Phase 2.
DATABASE_URL=postgresql+asyncpg://chainsentinel:change-me@localhost:5432/chainsentinel

# Explorer / indexer API for transaction history (Phase 2). Optional.
ETHERSCAN_API_KEY=

# API protection (Phase 2). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Analysis limits - protect against resource exhaustion
MAX_GRAPH_DEPTH=3
MAX_GRAPH_NODES=500
MAX_TX_HISTORY=5000
